---
import RootDocument from '../components/RootDocument.astro';
import site from '../data/site.json';
import activeTemplateConfig from '../data/active-template.json';
import { createAnalyticsConsentScript } from '../lib/analytics-consent';
import { getDesignTemplate } from '../lib/design-template-registry';

const gaMeasurementId = 'G-MT18WRFBGW';
const activeTemplateRecord = activeTemplateConfig as { template_id?: string; templateId?: string };
const activeTemplateId = activeTemplateRecord.template_id ?? activeTemplateRecord.templateId ?? 'link-index-mobile-first';
const ActiveTemplate = getDesignTemplate(activeTemplateId);

if (!ActiveTemplate) {
  throw new Error(`Unknown active design template: ${activeTemplateId}`);
}

const consentScript = createAnalyticsConsentScript(gaMeasurementId);
---

<RootDocument site={site}>
  <ActiveTemplate site={site} consentScript={consentScript} />
</RootDocument>
