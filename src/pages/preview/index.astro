---
import RootDocument from '../../components/RootDocument.astro';
import site from '../../data/site.json';
import candidateTemplates from '../../design-templates/candidate-templates.json';
import { designTemplateIds } from '../../lib/design-template-ids';

const implementedTemplateIds = new Set(designTemplateIds);
const templateCards = [
  {
    id: candidateTemplates.active_template_id,
    status: 'implemented_active',
    purpose: 'Current production template and comparison baseline.',
    primary_question: 'Does this remain the best public front door?',
    references: ['current-baseline'],
  },
  ...candidateTemplates.candidates,
].map((template) => ({
  ...template,
  implemented: implementedTemplateIds.has(template.id as (typeof designTemplateIds)[number]),
}));
---

<RootDocument site={site} titleSuffix="template previews" noindex>
  <main class="preview-index">
    <section class="preview-index__hero" aria-labelledby="preview-index-title">
      <div>
        <p class="preview-index__eyebrow">Templates</p>
        <h1 id="preview-index-title">Preview</h1>
      </div>
      <p>Production stays on <code>link-index-mobile-first</code> until a candidate is selected.</p>
    </section>

    <section class="preview-grid" aria-label="Template previews">
      {templateCards.map((template) => (
        template.implemented ? (
          <a class="preview-card preview-card--available" href={`/preview/${template.id}`}>
            <span class="preview-card__status">Available</span>
            <span class="preview-card__title">{template.id}</span>
            <span class="preview-card__purpose">{template.purpose}</span>
            <span class="preview-card__question">{template.primary_question}</span>
          </a>
        ) : (
          <article class="preview-card" aria-disabled="true">
            <span class="preview-card__status">Planned</span>
            <span class="preview-card__title">{template.id}</span>
            <span class="preview-card__purpose">{template.purpose}</span>
            <span class="preview-card__question">{template.primary_question}</span>
          </article>
        )
      ))}
    </section>
  </main>
</RootDocument>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f5f2ec;
    color: #0f100f;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif;
    overflow-x: hidden;
  }

  .preview-index {
    box-sizing: border-box;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 1rem 96px;
  }

  .preview-index__hero {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(15, 16, 15, 0.14);
  }

  .preview-index__eyebrow {
    margin: 0 0 0.4rem;
    color: rgba(15, 16, 15, 0.56);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    font-weight: 500;
  }

  .preview-index__hero p:last-child {
    max-width: 28rem;
    margin: 0;
    color: rgba(15, 16, 15, 0.64);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }

  .preview-card {
    box-sizing: border-box;
    min-width: 0;
    min-height: 230px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(15, 16, 15, 0.12);
    background: #fdfbf7;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 14px 36px rgba(15, 16, 15, 0.07);
  }

  .preview-card--available {
    border-color: #0f7c66;
  }

  .preview-card--available:hover,
  .preview-card--available:focus-visible {
    outline: 2px solid #0f7c66;
    outline-offset: 3px;
  }

  .preview-card__status {
    width: fit-content;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    background: rgba(15, 16, 15, 0.06);
    color: rgba(15, 16, 15, 0.66);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .preview-card--available .preview-card__status {
    background: rgba(15, 124, 102, 0.12);
    color: #0f7c66;
  }

  .preview-card__title {
    font-size: 1.2rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .preview-card__purpose,
  .preview-card__question {
    color: rgba(15, 16, 15, 0.66);
    overflow-wrap: anywhere;
  }

  .preview-card__question {
    margin-top: auto;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .preview-index {
      padding: 48px 0.75rem 72px;
    }

    .preview-index__hero {
      display: block;
    }

    .preview-index__hero p:last-child {
      margin-top: 1rem;
    }

    .preview-grid {
      grid-template-columns: 1fr;
    }

    .preview-card {
      min-height: 200px;
    }
  }

  @media (min-width: 1160px) {
    .preview-index {
      padding-inline: 0;
    }
  }
</style>
