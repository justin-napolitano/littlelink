{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/user-story-map.schema.json",
  "title": "User Story Map",
  "description": "User-centered story map for personal PR templates and client-facing design pitches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "product",
    "scope",
    "personas",
    "stories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "product": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "privacy_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^persona-[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "privacy_mode": {
            "type": "string",
            "enum": [
              "public",
              "public_reviewed",
              "selective",
              "private"
            ]
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "persona_id",
          "story",
          "why",
          "entry_points",
          "success_criteria",
          "anti_goals",
          "template_implications",
          "requirement_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^story-[a-z0-9][a-z0-9-]*$"
          },
          "persona_id": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "entry_points": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "anti_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "template_implications": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
