{
  "$schema": "../design-object-set.schema.json",
  "object_set_id": "garden-index.content_map.v1",
  "version": 1,
  "status": "implemented",
  "template_id": "garden-index",
  "kind": "content_map",
  "source_refs": [
    "src/design-templates/pitches/examples/jnap-garden-index.one-pager.json",
    "src/design-templates/contracts/garden-index.contract.json"
  ],
  "objects": [
    {
      "id": "content.identity",
      "type": "content_rule",
      "name": "Identity Content",
      "purpose": "Bind shared identity fields.",
      "status": "implemented",
      "content_bindings": [
        {
          "source_path": "hero.name",
          "target": "#garden-title",
          "rule": "Render without changing content."
        }
      ]
    },
    {
      "id": "content.routes",
      "type": "content_rule",
      "name": "Route Content",
      "purpose": "Bind shared sections and route links.",
      "status": "implemented",
      "content_bindings": [
        {
          "source_path": "sections[]",
          "target": ".garden-section",
          "rule": "Render in source order."
        },
        {
          "source_path": "sections[].links[]",
          "target": ".garden-link",
          "rule": "Preserve labels, URLs, icons, and new-tab behavior."
        }
      ]
    },
    {
      "id": "content.footer",
      "type": "content_rule",
      "name": "Footer Content",
      "purpose": "Bind privacy footer content.",
      "status": "implemented",
      "content_bindings": [
        {
          "source_path": "footer.privacyHref",
          "target": ".garden-footer",
          "rule": "Preserve privacy route."
        }
      ]
    }
  ],
  "build_rules": [
    "Update this design object before changing equivalent template CSS."
  ],
  "qa_gates": [
    "shared_content_unchanged"
  ]
}
