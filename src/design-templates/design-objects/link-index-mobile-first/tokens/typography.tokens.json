{
  "$schema": "../../schemas/design-token-file.schema.json",
  "$extensions": {
    "me.jnap": {
      "token_set_id": "link-index-mobile-first.typography.tokens.v1",
      "format": "DTCG 2025.10",
      "template_id": "link-index-mobile-first",
      "source_object_refs": [
        "src/design-templates/design-objects/link-index-mobile-first/typography.json"
      ]
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "'Fraunces', 'Georgia', serif",
      "$extensions": {
        "me.jnap": {
          "source_object_id": "font.display.identity",
          "css_variable": "--template-font-display",
          "css_fallback": "'Fraunces', 'Georgia', serif"
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif",
      "$extensions": {
        "me.jnap": {
          "source_object_id": "font.body.default",
          "css_variable": "--template-font-body",
          "css_fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif"
        }
      }
    }
  },
  "type": {
    "identity": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 48,
          "unit": "px"
        },
        "fontWeight": 560,
        "lineHeight": 1,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$extensions": {
        "me.jnap": {
          "source_object_id": "type.identity.name",
          "css_variable": "--template-type-identity",
          "css_fallback": "clamp(2.8rem, 6vw, 4rem)"
        }
      }
    },
    "route": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$extensions": {
        "me.jnap": {
          "source_object_id": "type.route.label",
          "css_variable": "--template-type-route",
          "css_fallback": "1rem"
        }
      }
    }
  }
}
