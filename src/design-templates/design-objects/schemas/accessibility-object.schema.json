{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/accessibility-object.schema.json",
  "title": "Accessibility Design Object Set",
  "description": "Accessibility-specific constraints layered on top of design-object-set.schema.json.",
  "type": "object",
  "required": [
    "kind",
    "objects"
  ],
  "properties": {
    "kind": {
      "const": "accessibility"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "requirements",
          "metadata"
        ],
        "properties": {
          "type": {
            "const": "accessibility_rule"
          },
          "requirements": {
            "type": "array",
            "minItems": 1
          },
          "metadata": {
            "type": "object",
            "properties": {
              "machine_checks": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "machine_checks"
            ]
          }
        }
      }
    }
  }
}
