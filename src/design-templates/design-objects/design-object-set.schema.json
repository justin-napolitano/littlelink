{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/design-object-set.schema.json",
  "title": "Design Object Set",
  "description": "Build-grade design objects for converting a design pitch into template implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_set_id",
    "version",
    "status",
    "template_id",
    "kind",
    "source_refs",
    "objects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "object_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved_for_build",
        "implemented",
        "retired"
      ]
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "palette",
        "typography",
        "spacing",
        "shape",
        "motion",
        "layout",
        "component",
        "content_map",
        "accessibility",
        "implementation_map"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "name",
          "purpose",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "implemented",
              "retired"
            ]
          },
          "value": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "css_variable": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "usage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "type": "object",
            "additionalProperties": true
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "trigger"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "tokens": {
                  "type": "object",
                  "additionalProperties": true
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "responsive": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "breakpoint",
                "behavior"
              ],
              "properties": {
                "breakpoint": {
                  "type": "string"
                },
                "behavior": {
                  "type": "string"
                },
                "tokens": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "content_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_path",
                "target",
                "rule"
              ],
              "properties": {
                "source_path": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                }
              }
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessibility": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "selectors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "test_hooks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "minItems": 1
    },
    "build_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
