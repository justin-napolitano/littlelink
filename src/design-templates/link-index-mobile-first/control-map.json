{
  "version": 1,
  "template_id": "link-index-mobile-first",
  "status": "active",
  "intent": "Accepted mobile-first link hub with warm identity and direct route objects.",
  "source_contracts": {
    "template_contract": "src/design-templates/contracts/link-index-mobile-first.contract.json",
    "pitch": "src/design-templates/pitches/examples/jnap-link-index-mobile-first.pitch.json",
    "one_pager": "src/design-templates/pitches/examples/jnap-link-index-mobile-first.one-pager.json",
    "build_plan": "src/design-templates/pitches/examples/jnap-link-index-mobile-first.build-plan.json",
    "design_objects": "src/design-templates/design-objects/link-index-mobile-first/",
    "tokens": [
      "src/design-templates/design-objects/link-index-mobile-first/tokens/color.tokens.json",
      "src/design-templates/design-objects/link-index-mobile-first/tokens/typography.tokens.json",
      "src/design-templates/design-objects/link-index-mobile-first/tokens/spacing.tokens.json"
    ]
  },
  "content_map": {
    "identity": {
      "source_paths": [
        "hero.name",
        "hero.subhead"
      ],
      "selectors": [
        ".hero",
        "h1"
      ],
      "rule": "Render shared identity content without adding pitch copy."
    },
    "route_clusters": {
      "source_paths": [
        "sections[]",
        "sections[].links[]"
      ],
      "selectors": [
        ".link-stack__section",
        ".link-pill",
        ".link-pill__label",
        ".link-pill__icon"
      ],
      "rule": "Preserve route labels, URLs, icon bindings, and source order."
    },
    "footer": {
      "source_paths": [
        "footer.privacyLabel",
        "footer.privacyHref"
      ],
      "selectors": [
        ".site-footer"
      ]
    },
    "privacy": {
      "source_paths": [
        "consentScript"
      ],
      "selectors": [
        ".consent-banner",
        ".consent-banner__actions"
      ]
    }
  },
  "css_token_map": {
    "color": [
      "color.surface.page",
      "color.surface.object",
      "color.text.primary",
      "color.text.secondary",
      "color.accent.primary",
      "color.line.soft"
    ],
    "type": [
      "font.display.identity",
      "font.body.default",
      "type.identity.name",
      "type.route.label"
    ],
    "space": [
      "space.page.padding",
      "space.stack.gap",
      "space.section.padding",
      "space.route.padding"
    ]
  },
  "activation_requirements": [
    "route labels and URLs are unchanged unless the content contract changes",
    "privacy and analytics behavior are unchanged",
    "mobile and desktop screenshots are reviewed",
    "npm run design:validate passes for all implemented templates"
  ]
}
