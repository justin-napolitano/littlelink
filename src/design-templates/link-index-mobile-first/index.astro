---
import './styles.css';

const { site, consentScript } = Astro.props;
const { hero, sections, footer } = site;
const isExternal = (href: string = '') => /^https?:\/\//.test(href);
---

<a class="index-skip" href="#links">Skip to links</a>
<main class="index-page" data-design-template="link-index-mobile-first">
  <header class="index-header">
    <h1>{hero.name}</h1>
    <nav aria-label="Directory sections">
      {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>
  </header>

  <div id="links" class="index-directory" tabindex="-1">
    {sections.map((section) => (
      <section class="index-section" aria-labelledby={`title-${section.id}`} id={section.id}>
        <h2 id={`title-${section.id}`}>{section.title || section.id}</h2>
        <ul>
          {section.links.map((link) => {
            const openInNewTab = link.newTab ?? isExternal(link.href);
            return (
              <li>
                <a
                  class="index-link"
                  href={link.href}
                  target={openInNewTab ? '_blank' : undefined}
                  rel={openInNewTab ? 'noopener' : undefined}
                >
                  <span class="index-link__label">{link.label}</span>
                  {link.meta && <span class="index-link__meta">{link.meta}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>

  <footer class="index-footer">
    {footer.text && <p>{footer.text}</p>}
    {footer.privacyHref && <a href={footer.privacyHref}>{footer.privacyLabel ?? 'Privacy policy'}</a>}
  </footer>
</main>
<div id="consentBanner" class="consent-banner" hidden role="dialog" aria-live="polite" aria-label="Analytics consent">
  <p>Analytics cookies?</p>
  <div class="consent-banner__actions">
    <button type="button" data-consent="accept">Allow</button>
    <button type="button" class="secondary" data-consent="decline">No</button>
  </div>
</div>
<script is:inline set:html={consentScript}></script>
