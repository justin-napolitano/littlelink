{
  "version": 1,
  "template_id": "quiet-index",
  "status": "implemented_preview",
  "intent": "Normal, trustworthy personal root with quiet surface treatment.",
  "source_contracts": {
    "template_contract": "src/design-templates/contracts/quiet-index.contract.json",
    "pitch": "src/design-templates/pitches/examples/jnap-quiet-index.pitch.json",
    "one_pager": "src/design-templates/pitches/examples/jnap-quiet-index.one-pager.json",
    "build_plan": "src/design-templates/pitches/examples/jnap-quiet-index.build-plan.json",
    "design_objects": "src/design-templates/design-objects/quiet-index/",
    "tokens": [
      "src/design-templates/design-objects/quiet-index/tokens/color.tokens.json",
      "src/design-templates/design-objects/quiet-index/tokens/typography.tokens.json",
      "src/design-templates/design-objects/quiet-index/tokens/spacing.tokens.json"
    ]
  },
  "content_map": {
    "identity": {
      "source_paths": [
        "hero.name",
        "hero.subhead"
      ],
      "selectors": [
        ".quiet-hero",
        "#quiet-title"
      ],
      "rule": "Render shared identity content without adding pitch copy."
    },
    "route_clusters": {
      "source_paths": [
        "sections[]",
        "sections[].links[]"
      ],
      "selectors": [
        ".quiet-section",
        ".quiet-link",
        ".quiet-link__label",
        ".quiet-link__icon"
      ],
      "rule": "Preserve route labels, URLs, icon bindings, and source order."
    },
    "footer": {
      "source_paths": [
        "footer.privacyLabel",
        "footer.privacyHref"
      ],
      "selectors": [
        ".quiet-footer"
      ]
    },
    "privacy": {
      "source_paths": [
        "consentScript"
      ],
      "selectors": [
        ".consent-banner",
        ".consent-banner__actions"
      ]
    }
  },
  "css_token_map": {
    "color": [
      "color.surface.page",
      "color.surface.object",
      "color.text.primary",
      "color.text.secondary",
      "color.accent.primary",
      "color.line.soft"
    ],
    "type": [
      "font.display.identity",
      "font.body.default",
      "type.identity.name",
      "type.route.label"
    ],
    "space": [
      "space.page.padding",
      "space.stack.gap",
      "space.section.padding",
      "space.route.padding"
    ]
  },
  "activation_requirements": [
    "route labels and URLs are unchanged unless the content contract changes",
    "privacy and analytics behavior are unchanged",
    "mobile and desktop screenshots are reviewed",
    "npm run design:validate passes for all implemented templates"
  ]
}
