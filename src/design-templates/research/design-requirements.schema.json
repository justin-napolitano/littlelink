{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/design-requirements.schema.json",
  "title": "Design Requirements",
  "description": "Build-facing requirements derived from user stories and bibliography references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "product",
    "scope",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "product": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "priority",
          "description",
          "source_story_ids",
          "bibliography_ids",
          "acceptance_checks",
          "anti_goals"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "description": {
            "type": "string"
          },
          "source_story_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "bibliography_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "anti_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
